<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁 自动福袋助手（免 Root）"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前状态：待启动"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1️⃣ 打开无障碍设置（启用本服务）" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="2️⃣ 开始自动参与" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⏹ 停止" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="⚙️ 高级设置"
            android:textSize="17sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbBlind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="盲点模式（识别不到文字时按坐标点击，建议开启）" />

        <CheckBox
            android:id="@+id/cbDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="调试提示（每步弹 Toast，方便排查）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="📍 福袋挂件坐标（屏幕百分比 %）"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etBagX"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="X% 例:10"
                android:inputType="numberDecimal" />
            <EditText
                android:id="@+id/etBagY"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Y% 例:12"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📍 参与按钮坐标"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etJoinX"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="X% 例:50"
                android:inputType="numberDecimal" />
            <EditText
                android:id="@+id/etJoinY"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Y% 例:62"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📍 发送按钮坐标"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etSendX"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="X% 例:85"
                android:inputType="numberDecimal" />
            <EditText
                android:id="@+id/etSendY"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Y% 例:88"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="💬 自定义评论内容（留空则自动轮换）"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：我要福袋"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="💾 保存设置" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="坐标获取方法：手机设置 → 开发者选项 → 打开「指针位置」，手动点一下目标位置，屏幕顶部会显示 x、y，用 x÷屏幕宽×100、y÷屏幕高×100 算出百分比填入即可。"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
